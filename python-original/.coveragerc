# coverage of the tool, as  pytest -n auto --cov  measures it (tests/README.md)
[run]
branch = False
parallel = True
source = .
omit =
    tests/*
    validation/*
    notes/*

[report]
fail_under = 95
show_missing = True
skip_covered = True
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
